// Esquema de datos de PantryMind.
//
// Convención: en el código los nombres van en camelCase y los modelos en
// singular; en la base de datos, tablas y columnas van en snake_case y las
// tablas en plural. La correspondencia se declara con @map y @@map.

generator client {
  provider     = "prisma-client"
  // Ruta relativa a este archivo. El cliente generado no se versiona.
  output       = "../src/generated/prisma"
  // @pantrymind/api es un paquete ESM ("type": "module").
  moduleFormat = "esm"
}

// La URL de conexión no va aquí: la CLI la lee de prisma7.config.ts y la
// aplicación se la pasa al adaptador en PrismaService.
datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  // @default(now()) da valor a la columna también en las filas que no crea
  // Prisma; @updatedAt la actualiza en cada cambio hecho con Prisma.
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  refreshTokens RefreshToken[]

  @@map("users")
}

// Refresh tokens de sesión. Solo se guarda el hash SHA-256 del valor: quien
// lea la tabla no puede usar los tokens. Todos los tokens que salen del mismo
// login comparten familyId (ver docs/adr/0004-session-tokens.md).
model RefreshToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  familyId  String    @map("family_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}
